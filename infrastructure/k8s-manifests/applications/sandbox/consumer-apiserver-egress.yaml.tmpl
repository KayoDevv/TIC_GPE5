# Template — do NOT apply as-is (contains __NODE_IP__).
# Generated + applied by `make netpol-apiserver` (auto-substitutes the discovered NODE_IP).
#
# Why a separate policy: the K3s kube-apiserver is host-networked, so it is not
# matchable by a namespaceSelector (it is NOT a pod). Calico enforces ipBlock
# correctly, but the node IP is host-specific → injected at deploy time from
# NODE_IP (no hardcoded IP in git). NetworkPolicies are additive: this rule adds
# to `consumer-egress` (Kafka/MinIO/DNS).
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: consumer-apiserver-egress
  namespace: sandbox
spec:
  podSelector:
    matchLabels: {app: sandbox-consumer}
  policyTypes: [Egress]
  egress:
    - to:
        - ipBlock: {cidr: __NODE_IP__/32}
      ports:
        - {protocol: TCP, port: 6443}   # apiserver direct (post-DNAT)
        - {protocol: TCP, port: 443}    # apiserver via ClusterIP DNAT
