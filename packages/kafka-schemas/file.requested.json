{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FileRequestedEvent",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "format": "uuid",
      "description": "Unique ID of the analysis request"
    },
    "s3_url": {
      "type": "string",
      "format": "uri",
      "description": "Presigned S3 URL or path of the file to analyze in the bucket"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$",
      "description": "SHA-256 fingerprint of the file"
    },
    "email_context": {
      "type": "object",
      "properties": {
        "sender": {"type": "string", "format": "email"},
        "subject": {"type": "string"},
        "body_text": {"type": "string", "description": "Email body content for the LLM"}
      },
      "required": ["sender", "subject", "body_text"]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    }
  },
  "required": ["job_id", "s3_url", "sha256", "email_context", "timestamp"]
}
