{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SandboxLayerResultEvent",
    "type": "object",
    "properties": {
        "job_id": {
            "type": "string",
            "format": "uuid"
        },
        "verdict": {
            "type": "string",
            "enum": [
                "benign",
                "needs_more_context",
                "malicious",
                "error"
            ],
            "description": "3-band sandbox verdict (guarded). The LLM Layer resolves needs_more_context."
        },
        "anomaly_score": {
            "type": "number",
            "minimum": 0.0,
            "maximum": 1.0
        },
        "analysis_trust": {
            "type": "object",
            "description": "Whether this run can be trusted, or observed nothing.",
            "properties": {
                "liveness_ok": {
                    "type": ["boolean", "null"]
                },
                "low_observability": {
                    "type": ["string", "null"],
                    "description": "Reason the run is a probable miss (no_liveness, quiet_benign), else null."
                },
                "timeout_triggered": {
                    "type": "boolean"
                },
                "error": {
                    "type": ["string", "null"]
                }
            }
        },
        "signals": {
            "type": "array",
            "description": "Per-hypothesis breakdown. evaluated=false means skipped (early-exit), score=null then.",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "score": {
                        "type": ["number", "null"]
                    },
                    "fired": {
                        "type": "boolean"
                    },
                    "evaluated": {
                        "type": "boolean"
                    }
                },
                "required": [
                    "name",
                    "fired",
                    "evaluated"
                ]
            }
        },
        "iocs": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "ip",
                            "domain",
                            "file_hash",
                            "registry_key",
                            "syscall",
                            "pdf_indicator"
                        ]
                    },
                    "value": {
                        "type": "string"
                    },
                    "mitre_tactic": {
                        "type": "string",
                        "description": "MITRE ATT&CK tactic (TA0xxx) or technique (Txxxx)."
                    },
                    "description": {
                        "type": "string"
                    }
                },
                "required": [
                    "type",
                    "value"
                ]
            },
            "description": "List of Indicators of Compromise"
        },
        "behavior_summary": {
            "type": "string",
            "description": "Human-readable summary for the UI and quick LLM read; the structured signals carry the detail."
        },
        "email_context": {
            "type": "object",
            "description": "Pass-through of the email context from the request for the LLM Layer"
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        },
        "_meta": {
            "type": "object",
            "description": "Operational metadata (not decision-facing).",
            "properties": {
                "prompt_injection_filtered": {
                    "type": "integer",
                    "description": "Count of chat-template control tokens neutralized in untrusted fields. Weak signal, never a detection claim."
                }
            }
        }
    },
    "required": [
        "job_id",
        "iocs",
        "behavior_summary",
        "email_context",
        "timestamp"
    ]
}
