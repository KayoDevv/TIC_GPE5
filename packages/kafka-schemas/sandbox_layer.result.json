{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "SandboxLayerResultEvent",
    "type": "object",
    "properties": {
        "job_id": {
            "type": "string",
            "format": "uuid"
        },
        "iocs": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "type": {
                        "type": "string",
                        "enum": [
                            "ip",
                            "domain",
                            "file_hash",
                            "registry_key",
                            "syscall"
                        ]
                    },
                    "value": {
                        "type": "string"
                    },
                    "mitre_tactic": {
                        "type": "string",
                        "description": "MITRE ATT&CK tactic (e.g. TA0011, TA0002)"
                    },
                    "description": {
                        "type": "string"
                    }
                },
                "required": [
                    "type",
                    "value"
                ]
            },
            "description": "List of Indicators of Compromise"
        },
        "behavior_summary": {
            "type": "string",
            "description": "Raw behavior summary for ingestion by the LLM"
        },
        "email_context": {
            "type": "object",
            "description": "Pass-through of the email context from the request for the LLM Layer"
        },
        "timeout_triggered": {
            "type": "boolean",
            "default": false
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        }
    },
    "required": [
        "job_id",
        "iocs",
        "behavior_summary",
        "email_context",
        "timestamp"
    ]
}