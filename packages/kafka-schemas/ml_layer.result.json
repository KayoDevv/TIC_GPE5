{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "MlLayerResultEvent",
    "type": "object",
    "properties": {
        "job_id": {
            "type": "string",
            "format": "uuid"
        },
        "risk_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100,
            "description": "Risk score computed by the static ML model"
        },
        "static_tags": {
            "type": "array",
            "items": {
                "type": "string"
            },
            "description": "Tags such as 'packer_detected', 'high_entropy', 'known_malware'"
        },
        "analysis_status": {
            "type": "string",
            "enum": [
                "completed",
                "unsupported_file_type",
                "analysis_failed"
            ],
            "default": "completed",
            "description": "Whether the static model actually scored the file"
        },
        "processing_time_ms": {
            "type": "integer",
            "description": "Processing time in ms (SLA < 500ms)"
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        }
    },
    "required": [
        "job_id",
        "risk_score",
        "static_tags",
        "timestamp"
    ]
}