{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "LlmLayerResultEvent",
    "type": "object",
    "properties": {
        "job_id": {
            "type": "string",
            "format": "uuid"
        },
        "is_malicious": {
            "type": "boolean",
            "description": "Binary decision Malicious/Clean"
        },
        "explanation_text": {
            "type": "string",
            "description": "Untrusted natural-language text from the LLM (control chars/tokens stripped at the producer boundary). The consumer MUST output-encode it per render context (e.g. HTML-escape in the UI)."
        },
        "confidence_score": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        }
    },
    "required": [
        "job_id",
        "is_malicious",
        "explanation_text",
        "timestamp"
    ]
}