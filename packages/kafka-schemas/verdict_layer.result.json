{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "title": "VerdictResultEvent",
    "type": "object",
    "properties": {
        "job_id": {
            "type": "string",
            "format": "uuid",
            "description": "Unique ID of the analysis request"
        },
        "final_decision": {
            "type": "string",
            "enum": [
                "allowed",
                "blocked",
                "warning"
            ],
            "description": "Final decision to be applied by the Frontend"
        },
        "user_explanation": {
            "type": "string",
            "description": "Explanatory text generated by the LLM Layer (if available) or a default one on a Sandbox timeout"
        },
        "technical_summary": {
            "type": "object",
            "properties": {
                "ml_layer_score": {
                    "type": "integer"
                },
                "sandbox_layer_iocs": {
                    "type": "array",
                    "items": {
                        "type": "object"
                    }
                },
                "sandbox_layer_timeout": {
                    "type": "boolean"
                },
                "llm_layer_malicious": {
                    "type": "boolean"
                }
            },
            "description": "Summary of the data that led to the decision (useful for history and the Admin dashboard)"
        },
        "timestamp": {
            "type": "string",
            "format": "date-time"
        }
    },
    "required": [
        "job_id",
        "final_decision",
        "timestamp"
    ]
}