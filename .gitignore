# Standard Python & Node.js gitignore
node_modules/
__pycache__/
*.py[cod]
*$py.class
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
dist/
build/
*.egg-info/
.DS_Store
*.example

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
# .terraform.lock.hcl est volontairement commité pour stabiliser la CI

# Claude
.claude/
*CLAUDE.md

apps/workers/ml_layer/data/
# Outils productivité locaux (non partagés)
memory/
TASKS.md
dashboard.html

# K8s manifests générés au déploiement (IP host dépendante du dev)
infrastructure/k8s-manifests/overlays/dev/host-egress-patch.yaml

# Pipeline de validation : DB locale + corpus (samples malware JAMAIS en clair dans git)
validation/feeder_state.duckdb
validation/feeder_state.duckdb.wal
validation/results.duckdb
validation/results.duckdb.wal
validation/corpus/
validation/report*.md
# Corpus de samples — réels malwares PDF/ELF, ne doivent JAMAIS être committés
scripts/validation/real_corpus/
scripts/validation/corpus/
tmp/
