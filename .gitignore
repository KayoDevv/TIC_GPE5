# Standard Python & Node.js gitignore
node_modules/
__pycache__/
*.py[cod]
*$py.class
.coverage
.coverage.*
htmlcov/
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
dist/
build/
*.egg-info/
.DS_Store
*.example

# Terraform
.terraform/
*.tfstate
*.tfstate.backup
# .terraform.lock.hcl is intentionally committed to stabilize CI

# Claude
.claude/
*CLAUDE.md

apps/workers/ml_layer/data/
# Fetched malware / benign corpora + experiment holdouts — real malware, NEVER commit.
apps/workers/ml_layer/data_*/
# ML experiment artifacts: candidate models, backups, feature cache, FP dumps.
apps/workers/ml_layer/models/*_v[0-9]*.onnx
apps/workers/ml_layer/models/*_v[0-9]*.metadata.json
apps/workers/ml_layer/models/*.onnx.bak
apps/workers/ml_layer/models/.feature_cache*.csv
apps/workers/ml_layer/models/false_positives.csv
# Local productivity tools (not shared)
memory/
TASKS.md
dashboard.html

# K8s manifests generated at deploy time (host IP, dev-dependent)
infrastructure/k8s-manifests/overlays/dev/host-egress-patch.yaml

# Validation pipeline: local DB + corpus (malware samples NEVER stored in git)
validation/feeder_state.duckdb
validation/feeder_state.duckdb.wal
validation/results.duckdb
validation/results.duckdb.wal
validation/corpus/
validation/report*.md
# Sample corpus — real PDF/ELF malware, must NEVER be committed.
# Wide net: any *_corpus/ or *_test/ folder under scripts/validation/ is a
# local corpus (scope_test, big_test, etc.) → ignored by default.
scripts/validation/real_corpus/
scripts/validation/corpus/
scripts/validation/*_corpus/
scripts/validation/*_test/
# Validation run logs — kept local, never committed
validation/logs/
validation_*.log
tmp/
