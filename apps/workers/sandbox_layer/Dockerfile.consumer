# Image du consumer K8s — dispatcher Kafka → batch/v1 Job
# Reçoit les messages file.requested et crée un Job par sample.
#
# Build : docker build -t ghcr.io/kayodevv/charon-sandbox-consumer:latest \
#                      -f apps/workers/sandbox_layer/Dockerfile.consumer .
# (à lancer depuis la racine du monorepo GPE-ETNA)

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Dépendances système minimales
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Dépendances Python
RUN pip install --no-cache-dir \
    aiokafka==0.10.0 \
    kubernetes==29.0.0 \
    structlog==24.1.0 \
    pydantic==2.7.1

# Code source
COPY apps/workers/sandbox_layer/consumer.py ./consumer.py

# L'utilisateur non-root n'est pas nécessaire ici : ce pod ne lance pas de samples.
# Il a besoin du ServiceAccount K8s pour créer des Jobs (injecté en runtime).

CMD ["python", "-u", "consumer.py"]
