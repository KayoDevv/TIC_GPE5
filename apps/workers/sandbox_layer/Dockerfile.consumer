# ghcr-image: charon-sandbox-consumer:v1.0.0
# K8s consumer image — Kafka dispatcher → batch/v1 Job
# Receives file.requested messages and creates one Job per sample.
#
# Build: docker build -t ghcr.io/kayodevv/charon-sandbox-consumer:latest \
#                     -f apps/workers/sandbox_layer/Dockerfile.consumer .
# (run from the root of the GPE-ETNA monorepo)

FROM python:3.12-slim

WORKDIR /app

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Minimal system dependencies
# hadolint ignore=DL3008
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Python dependencies
RUN pip install --no-cache-dir \
    aiokafka==0.10.0 \
    kubernetes==29.0.0 \
    structlog==24.1.0 \
    pydantic==2.7.1

# Source code
COPY apps/workers/sandbox_layer/consumer.py ./consumer.py

# A non-root user is not needed here: this pod does not run samples.
# It needs the K8s ServiceAccount to create Jobs (injected at runtime).

CMD ["python", "-u", "consumer.py"]
